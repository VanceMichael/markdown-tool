{
  "name": "md-writer",
  "version": "1.0.0",
  "description": "A local Markdown writing tool for weekly reports",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && concurrently -k \"vite\" \"wait-on http://localhost:5180 && electron .\"",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "dev:build-main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "electron:build": "npm run build && electron-builder",
    "typecheck": "vue-tsc --noEmit"
  },
  "build": {
    "appId": "com.mdwriter.app",
    "productName": "MD Writer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "vue": "^3.4.0",
    "marked": "^12.0.0",
    "highlight.js": "^11.9.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0"
  }
}
